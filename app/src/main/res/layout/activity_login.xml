<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="48dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Telegram Login"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="48dp" />

    <!-- QR-Code Login Button (Ideal für Fernbedienung) -->
    <Button
        android:id="@+id/btn_qr_login"
        android:layout_width="400dp"
        android:layout_height="60dp"
        android:text="Mit QR-Code verbinden (Empfohlen)"
        android:textSize="16sp"
        android:focusable="true"
        android:layout_marginBottom="16dp" />

    <!-- Telefonnummer Login Button -->
    <Button
        android:id="@+id/btn_phone_login"
        android:layout_width="400dp"
        android:layout_height="60dp"
        android:text="Mit Telefonnummer anmelden"
        android:textSize="16sp"
        android:focusable="true" />

</LinearLayout>
